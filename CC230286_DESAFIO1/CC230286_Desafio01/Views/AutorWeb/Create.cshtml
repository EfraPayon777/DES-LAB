@model CC230396_Desafio01.Entities.Dtos.AutorDto
@{
    ViewData["Title"] = "Registrar Autor";
}

<h2>Formulario de Registro de Autores</h2>
<hr />

<form asp-action="Create" method="post" class="w-50">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Nombre del Autor:</label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Apellido del Autor:</label>
        <input asp-for="Apellido" class="form-control" />
        <span asp-validation-for="Apellido" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Guardar Autor</button>
</form>